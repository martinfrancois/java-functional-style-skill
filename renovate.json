{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "reviewers": [
    "martinfrancois"
  ],
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": false,
  "rangeStrategy": "pin",
  "pinDigests": true,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "dependencyDashboardApproval": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": false,
  "schedule": [
    "* 0-4 * * 5"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [],
    "updateNotScheduled": true,
    "minimumReleaseAge": null,
    "groupName": null,
    "groupSlug": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:commitlint|release-please)\\.yml$/",
        "/^scripts/(?:commitlint_release_pr|install_commitlint)\\.sh$/"
      ],
      "matchStrings": [
        "(?:\\s+)(?<depName>@commitlint/(?:cli|config-conventional))@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:ci|commitlint|publish-tessl|release-please|skill-review)\\.yml$/"
      ],
      "matchStrings": [
        "version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "tessl-cli",
      "datasourceTemplate": "npm",
      "packageNameTemplate": "tessl",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Bundle every non-major update into one automergeable pull request. Major updates are deliberately excluded so that a pending major never holds back the bundle.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "automerge": true
    },
    {
      "description": "Major updates require human review. The final private-repository grouping rules collect reviewed updates without changing this merge requirement.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ]
    },
    {
      "description": "Private repository: combine eligible automatic updates after package-specific rules to conserve Actions minutes. Keep existing review requirements unchanged.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchJsonata": [
        "automerge = true"
      ],
      "groupName": "Routine dependency updates",
      "groupSlug": "routine-dependencies"
    },
    {
      "description": "Private repository: bundle review-required updates without enabling automerge. Keep majors separate from reviewed non-major updates so incompatible major upgrades do not block other reviewed fixes.",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchJsonata": [
        "$not(automerge = true)"
      ],
      "groupName": "Reviewed dependency updates",
      "groupSlug": "reviewed-dependencies",
      "automerge": false
    }
  ],
  "updateNotScheduled": false,
  "separateMinorPatch": false
}
